<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
  <changeSet id="20251106000001-1" author="jungsoo">
    <addColumn tableName="verifier">
      <column name="wallet_address" type="varchar(255)">
        <constraints nullable="false" />
      </column>
      <column name="parameters" type="${clobType}">
        <constraints nullable="false" />
      </column>
    </addColumn>
    <dropColumn tableName="verifier" columnName="api_key"/>
    <addColumn tableName="agent">
      <column name="wallet_address" type="varchar(255)">
        <constraints nullable="false" />
      </column>
    </addColumn>
    <dropColumn tableName="agent" columnName="api_key"/>
    <dropColumn tableName="agent" columnName="api_url"/>
  </changeSet>
</databaseChangeLog>
