<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="20251117000001-1" author="jungsoo">
    <addColumn tableName="user_subscr">
      <column name="wallet_address" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="verifier_address" type="varchar(255)">
        <constraints nullable="true"/>
      </column>
      <column name="activated_at" type="${datetimeType}">
        <constraints nullable="true"/>
      </column>
      <column name="num_exec" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="ref_id" type="varchar(100)">
        <constraints nullable="true"/>
      </column>
    </addColumn>
    <dropDefaultValue tableName="user_subscr" columnName="activated_at" columnDataType="${datetimeType}"/>
  </changeSet>
</databaseChangeLog>
